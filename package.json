{
  "name": "auvrynt",
  "version": "1.0.5",
  "description": "Expose a secure local coding workspace through an MCP server.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12 <27"
  },
  "bin": {
    "auvrynt": "bin/auvrynt-launcher.cjs"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "guides",
    "scripts",
    "addons",
    "extensions",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run build:app && tsc -p tsconfig.build.json",
    "build:app": "vite build",
    "dev": "node scripts/dev-server.mjs",
    "start": "node dist/cli.js serve",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit --noFallthroughCasesInSwitch --allowUnreachableCode false --allowUnusedLabels false --noImplicitReturns",
    "hygiene": "node scripts/repo-hygiene.mjs --check",
    "hygiene:fix": "node scripts/repo-hygiene.mjs --fix",
    "prepublishOnly": "npm run hygiene && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^0.79.4",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "protobufjs": "7.6.5",
    "ws": "8.21.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "@google/genai@1.52.0": true
  }
}
