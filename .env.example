HOST=127.0.0.1
PORT=49321
# Owner password generated by `auvrynt init` in ~/.auvrynt/auth.json. Set this
# only for non-interactive or fully env-driven deployments.
# AUVRYNT_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# AUVRYNT_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# AUVRYNT_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUVRYNT_OAUTH_SCOPES=auvrynt:read,auvrynt:write,auvrynt:process,auvrynt:web,auvrynt:software,auvrynt:godot,auvrynt:blender,auvrynt:aseprite,auvrynt:serena
# AUVRYNT_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,claude.ai,oauth-redirect.googleusercontent.com,localhost,127.0.0.1
# Optional static OAuth client credentials (e.g. for manual client entry in Gemini or custom tools):
# AUVRYNT_OAUTH_CLIENT_ID=my-client-id
# AUVRYNT_OAUTH_CLIENT_SECRET=my-client-secret
# AUVRYNT_OAUTH_REDIRECT_URIS=https://oauth-redirect.googleusercontent.com/r/user_bound_custom-mcp-109752885578851795204-mcp_auvrynt_dpdns_org
AUVRYNT_ALLOWED_ROOTS=/home/user/personal,/home/user/work
# For temporary tunnels, prefer setting this per run. Auvrynt derives the
# inbound Host allowlist from this URL.
# AUVRYNT_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# AUVRYNT_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
# Which tunnel provider `auvrynt start` manages. Defaults to cloudflare.
# AUVRYNT_TUNNEL_PROVIDER=cloudflare
# Required only when AUVRYNT_TUNNEL_PROVIDER=ngrok and ngrok isn't already
# authenticated via `ngrok config add-authtoken`.
# AUVRYNT_NGROK_AUTHTOKEN=change-me-to-your-ngrok-authtoken
# Optional stable ngrok HTTPS origin reserved on your ngrok account. Auvrynt
# starts ngrok with `--url` and discovers the active URL from the agent logs;
# it does not depend on ngrok's shared localhost:4040 inspector API.
# AUVRYNT_NGROK_URL=https://your-name.ngrok.app
# Optional authenticated Arbiter typed-decision service. The API key is read
# server-side and should normally be saved in ~/.auvrynt/auth.json rather than
# this file. Arbiter is not a generative coding-model provider or a validator.
# AUVRYNT_ARBITER_ENABLED=1
# AUVRYNT_ARBITER_URL=https://arbiter.example.com
# AUVRYNT_ARBITER_MODEL=laya-typed-decisions
# AUVRYNT_ARBITER_TIMEOUT_MS=10000
# AUVRYNT_ARBITER_API_KEY=change-me-to-a-private-arbiter-key
AUVRYNT_TOOL_MODE=full
AUVRYNT_TOOL_NAMING=legacy
# off | changes | full. Defaults to full.
# changes creates one aggregate review widget via review_changes instead of per-tool iframes.
AUVRYNT_WIDGETS=changes
# Serena is enabled automatically when its executable or process is detected.
# Set either switch explicitly to override detection; 0 hides Serena from
# connected web agents and stops its sessions.
# AUVRYNT_SERENA_ENABLED=1
# AUVRYNT_SERENA_INTEGRATION_ENABLED=1
# Aseprite native CLI/Lua integration. Point at either the built executable or
# a source tree containing build/bin/aseprite.exe.
# AUVRYNT_ASEPRITE_ENABLED=1
# AUVRYNT_ASEPRITE_PATH=C:\\tools\\aseprite.exe
# AUVRYNT_ASEPRITE_SOURCE_PATH=C:\\src\\aseprite
# Opt-in OpenPencil editor detection and managed official MCP setup.
# AUVRYNT_OPEN_PENCIL_ENABLED=1
# Optional Jobs/Facebook account linking. Register
# http://127.0.0.1:<PORT>/dashboard/jobs/integrations/facebook/callback
# in the Facebook app's OAuth settings. These values are read by the server;
# never paste the app secret into the dashboard or browser.
# AUVRYNT_JOBS_FACEBOOK_APP_ID=your-facebook-app-id
# AUVRYNT_JOBS_FACEBOOK_APP_SECRET=your-facebook-app-secret
# AUVRYNT_JOBS_FACEBOOK_ENABLED=1
# AUVRYNT_JOBS_FACEBOOK_GRAPH_VERSION=v22.0
AUVRYNT_LOG_LEVEL=info
AUVRYNT_LOG_FORMAT=json
AUVRYNT_LOG_REQUESTS=1
AUVRYNT_LOG_ASSETS=0
AUVRYNT_LOG_TOOL_CALLS=1
AUVRYNT_LOG_SHELL_COMMANDS=0
# AUVRYNT_TRUST_PROXY=1
# AUVRYNT_STATE_DIR=/home/user/.local/share/auvrynt
# AUVRYNT_WORKTREE_ROOT=/home/user/.auvrynt/worktrees
# Active sessions and in-flight tool calls are never evicted for capacity. Closed transports are removed immediately.
# Idle sessions remain available for 12 hours, then close immediately with no default grace period.
# Long-running QA processes started with start_process continue independently of the MCP transport session.
# AUVRYNT_SESSION_IDLE_MS=43200000
# AUVRYNT_DISCONNECT_GRACE_MS=0
# Session limits may be lowered but cannot exceed Auvrynt's hard maximum of 256.
# AUVRYNT_MAX_SESSIONS=32
# AUVRYNT_MAX_SESSIONS_PER_CLIENT=8
# AUVRYNT_AUTO_LOAD_AGENTS_MD=1
# Skills are enabled by default. Set AUVRYNT_SKILLS=0 to hide them.
# AUVRYNT_SKILLS=0
# AUVRYNT_AGENT_DIR=/home/user/.codex
# AUVRYNT_SKILL_PATHS=/home/user/.codex/skills,/home/user/.claude/skills
